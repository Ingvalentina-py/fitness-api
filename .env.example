# Plantilla de variables de entorno.
# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca se sube a GitHub.

# Entorno: development | test | production
NODE_ENV=development

# Puerto del servidor local
PORT=3000

# Cadena de conexión de MongoDB Atlas (Connect → Drivers).
# Reemplaza <db_password> por la contraseña del usuario de la base de datos.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos dentro del clúster (se crea sola al guardar el primer dato)
MONGODB_DB_NAME=fitness

# Clave secreta para firmar las sesiones (JWT): aleatoria y de al menos 32 caracteres.
# Genera una con este comando y pégala aquí. Usa una distinta en producción.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcional, solo en tu computador: servidores DNS para resolver mongodb+srv://.
# Úsalo si al arrancar ves "querySrv ECONNREFUSED" (le pasa a Node en algunos Windows).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Direcciones del frontend que pueden llamar a la API, separadas por comas
CORS_ORIGIN=http://localhost:5173
